<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.kk</groupId>
  <artifactId>content-center-sdk</artifactId>
  <version>0.1.2</version>
  <packaging>jar</packaging>

  <name>content-center-sdk</name>
  <description>内容中心（k-File）开放 API 官方 Java SDK：appToken 鉴权 + 预签名直传上传（简单/分片断点续传）+ 预签名下载链接 + 图片/音频/视频 CDN 预览链接（默认永久，支持指定有效期）</description>

  <!-- 发布到 GitHub Packages（kK-2004/kFile 仓库命名空间），与根 pom 拉取 kmessage-sdk 的模式对称。
       版本规则：只允许正式版本（GitHub Packages 不支持 SNAPSHOT）；同一版本禁止重复发布，
       由 .github/workflows/sdk-release.yml 在发布前校验。发新版 = 升级本 pom 的 version 后合入 master。 -->
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub kK-2004/kFile Packages</name>
      <url>https://maven.pkg.github.com/kK-2004/kFile</url>
    </repository>
  </distributionManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <jackson.version>2.18.2</jackson.version>
    <junit.version>5.11.4</junit.version>
  </properties>

  <dependencies>
    <!-- 唯一运行期依赖：JSON 序列化；HTTP 使用 JDK java.net.http.HttpClient -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.27.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
    </plugins>
  </build>
</project>
